# Скопируй в .env и поправь под себя. Файл читается при старте CLI,
# существующие переменные окружения всегда имеют приоритет.

# Где лежат данные: снапшот каталога и словарь алиасов.
COCKTAIL_DATA_DIR=data/raw
COCKTAIL_SNAPSHOT=data/raw/cocktails.json
COCKTAIL_ALIASES=data/aliases.yaml

# Источник данных (TheCocktailDB, публичный тестовый ключ "1").
COCKTAIL_API_BASE=https://www.thecocktaildb.com/api/json/v1/1
COCKTAIL_HTTP_TIMEOUT=20

# --- Будущий Telegram-бот (этап 6, сейчас не используется) -------------------
# TELEGRAM_BOT_TOKEN=
